# Domain
DOMAIN=n8n.as-trade.be

# Timezone
TZ=Europe/Brussels

# PostgreSQL
POSTGRES_DB=asbrain
POSTGRES_USER=asbrain
POSTGRES_PASSWORD=CHANGE_ME

# n8n
N8N_HOST=n8n.as-trade.be
N8N_PORT=5678
N8N_PROTOCOL=https

# Encryption
N8N_ENCRYPTION_KEY=CHANGE_ME

# Basic Auth
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME